# ========== Database Configuration ==========
# For SQLite (development): sqlite:///./smartstock.db
# For PostgreSQL: postgresql://username:password@localhost/smartstock
DATABASE_URL=sqlite:///./smartstock.db

# ========== Security Configuration ==========
# Change this to a random secret key in production!
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-change-this-in-production-12345

# JWT token expiration time (in minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ========== CORS Configuration ==========
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://localhost:8080

# ========== Gemini API Configuration (Optional) ==========
# Leave empty if not using AI explanations
GEMINI_API_KEY=

# ========== Server Configuration ==========
HOST=0.0.0.0
PORT=8000
